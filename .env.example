# FlowStep AI — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control

# Anthropic API Key (required for real AI — mock mode works without it)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# JWT Secret for session authentication (required)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-256-bit-string

# MCP Filesystem Allow-List (comma-separated absolute paths)
# These are the ONLY directories the agent can read/write
MCP_ALLOW_LIST=/path/to/project1,/path/to/project2

# Session Configuration
SESSION_TIMEOUT_MINUTES=480
MAX_TASKS_PER_SESSION=20

# Logging
LOG_LEVEL=INFO

# Notion Integration (see docs/NOTION_SETUP.md for complete setup guide)
# 1. Create an integration at https://www.notion.so/profile/integrations
# 2. Copy the Internal Integration Secret here
NOTION_API_TOKEN=secret_your-notion-token-here

# 3. Create a root page in Notion and copy its ID (see docs/NOTION_SETUP.md)
NOTION_ROOT_PAGE_ID=your-page-id-here

# 4. Run the setup script to create databases, then paste the IDs here
#    docker compose exec backend python -m notion.setup_databases
NOTION_TASKS_DB_ID=
NOTION_LOG_DB_ID=
